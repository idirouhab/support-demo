# Append missing keys to your existing .env; do not overwrite it.
# OPENAI_API_KEY is accepted too. Never commit .env or token values.
OPENAI_API=
GITLAB_TOKEN=
OPENAI_AGENT_MODEL=gpt-6-astra
# provision writes these non-secret IDs to ignored .cloud-agents.json.
# For scheduled GitLab dispatch, copy them into protected CI variables.
CLOUD_REVIEWER_ID=
CLOUD_MERGER_ID=
CLOUD_VAULT_ID=
CLOUD_CREDENTIAL_ID=
